{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pull request, version 1",
  "description": "The change of a Build run: title, text, commits and steps.",
  "type": "object",
  "required": [
    "target",
    "title",
    "text",
    "commits",
    "head",
    "base",
    "branch",
    "base_branch",
    "steps",
    "draft"
  ],
  "additionalProperties": false,
  "properties": {
    "target": {
      "title": "Target",
      "$ref": "#/$defs/reference"
    },
    "title": {
      "title": "Title",
      "$ref": "#/$defs/title"
    },
    "text": {
      "title": "Description",
      "$ref": "#/$defs/text"
    },
    "commits": {
      "title": "Commits",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/commit"
      },
      "x-qory-fill": "pushed-commits"
    },
    "head": {
      "title": "Head commit",
      "$ref": "#/$defs/commit",
      "x-qory-fill": "pushed-head"
    },
    "base": {
      "title": "Base commit",
      "$ref": "#/$defs/commit",
      "x-qory-fill": "pushed-base"
    },
    "branch": {
      "title": "Branch",
      "type": "string",
      "maxLength": 255,
      "pattern": "^[^\\x00-\\x20\\x7f~^:?*\\[\\\\/-][^\\x00-\\x20\\x7f~^:?*\\[\\\\]*$",
      "not": {
        "pattern": "\\.\\.|//|@\\{|(^|/)\\.|\\.lock(/|$)|[./]$|^@$"
      },
      "allOf": [
        {
          "$ref": "#/$defs/line"
        }
      ],
      "x-qory-fill": "pushed-branch"
    },
    "base_branch": {
      "title": "Base branch",
      "type": "string",
      "maxLength": 255,
      "pattern": "^[^\\x00-\\x20\\x7f~^:?*\\[\\\\/-][^\\x00-\\x20\\x7f~^:?*\\[\\\\]*$",
      "not": {
        "pattern": "\\.\\.|//|@\\{|(^|/)\\.|\\.lock(/|$)|[./]$|^@$"
      },
      "allOf": [
        {
          "$ref": "#/$defs/line"
        }
      ],
      "x-qory-fill": "pushed-base-branch"
    },
    "earlier_commits": {
      "title": "Earlier commits",
      "type": "integer",
      "minimum": 1,
      "x-qory-fill": "pushed-commits-left-out"
    },
    "steps": {
      "title": "Steps",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "commit",
          "step"
        ],
        "additionalProperties": false,
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "step": {
            "type": "string",
            "$ref": "#/$defs/line",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "draft": {
      "title": "Draft",
      "type": "boolean"
    }
  },
  "$defs": {
    "line": {
      "description": "One line of text: it has no control character, so no tab and no line break, no U+2028 or U+2029, and no Cf character but U+200C and U+200D, the joiners of emoji.",
      "type": "string",
      "pattern": "^[^\u0000-\u001f\u007f-\u009f\u00ad\u0600-\u0605\u061c\u06dd\u070f\u0890\u0891\u08e2\u180e\u200b\u200e\u200f\u2028-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb\ud804\udcbd\ud804\udccd\ud80d\udc30-\ud80d\udc3f\ud82f\udca0-\ud82f\udca3\ud834\udd73-\ud834\udd7a\udb40\udc01\udb40\udc20-\udb40\udc7f]*$"
    },
    "title": {
      "description": "One line of text, 1 to 256 characters, not only spaces and joiners.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "allOf": [
        {
          "$ref": "#/$defs/line"
        },
        {
          "pattern": "[^ \u00a0\u1680\u2000-\u200a\u202f\u205f\u3000\u200c\u200d]"
        }
      ]
    },
    "text": {
      "description": "Markdown. Tab, line feed and carriage return are its only control characters. It has no U+2028 or U+2029 and no Cf character but U+200C and U+200D, the joiners of emoji.",
      "type": "string",
      "maxLength": 20000,
      "pattern": "^[^\u0000-\b\u000b\f\u000e-\u001f\u007f-\u009f\u00ad\u0600-\u0605\u061c\u06dd\u070f\u0890\u0891\u08e2\u180e\u200b\u200e\u200f\u2028-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb\ud804\udcbd\ud804\udccd\ud80d\udc30-\ud80d\udc3f\ud82f\udca0-\ud82f\udca3\ud834\udd73-\ud834\udd7a\udb40\udc01\udb40\udc20-\udb40\udc7f]*$",
      "not": {
        "pattern": "(^|\\n)<!-- qory:(start|end) -->"
      }
    },
    "reference": {
      "description": "An object in a system: a collection, and its address when it has one.",
      "type": "object",
      "required": [
        "collection"
      ],
      "additionalProperties": false,
      "properties": {
        "collection": {
          "type": "string",
          "$ref": "#/$defs/line",
          "minLength": 1,
          "maxLength": 200
        },
        "address": {
          "type": "object",
          "required": [
            "system",
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "system": {
              "type": "string",
              "pattern": "^[a-z0-9.-]{1,253}$"
            },
            "path": {
              "type": "string",
              "$ref": "#/$defs/line",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      }
    },
    "commit": {
      "description": "A commit: the repository is the collection, the commit id is the path.",
      "allOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "required": [
            "address"
          ],
          "properties": {
            "address": {
              "properties": {
                "path": {
                  "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
                }
              }
            }
          }
        }
      ]
    }
  }
}
