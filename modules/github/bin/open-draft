#!/bin/sh
# open-draft: the submit program of the module github. qory runs it once for each
# repository of a local run, after it pushed the run's branch, and reads the lines
# it prints. It prints the address of each commit and, for QORY_SUBMIT_DRAFT=open,
# opens or edits the draft pull request with the login of `gh`. It pushes nothing.
set -eu
set -f

LC_ALL=C
export LC_ALL
umask 077

# gh must not prompt, page, colour or check for updates.
GH_PROMPT_DISABLED=1
GH_NO_UPDATE_NOTIFIER=1
GH_SPINNER_DISABLED=1
GH_PAGER=cat
NO_COLOR=1
export GH_PROMPT_DISABLED GH_NO_UPDATE_NOTIFIER GH_SPINNER_DISABLED GH_PAGER NO_COLOR

START='<!-- qory:start -->'
END='<!-- qory:end -->'
HOST=github.com
MAX_TITLE=256
MAX_DESCRIPTION=20000
LOGIN_LINE='Run `gh auth login`, then `qory run` again.'

# gh prints a pull request as these 8 lines. A read of one pull request adds its
# description after them. merged is true when merged_at is set.
FIELDS='(.number | tostring), .head.ref, (.head.repo.full_name // "-"), .state, ((.merged_at != null) | tostring), ((.draft == true) | tostring), .title, .html_url'
LIST_JQ=".[] | $FIELDS"
READ_JQ="$FIELDS, (.body // \"\")"

tmp=
cleanup() {
	if [ -n "$tmp" ]; then
		rm -rf "$tmp"
	fi
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

# refuse prints the fix on stderr and ends with status 2: the inputs cannot be used.
refuse() {
	printf '%s\n' "$1" >&2
	exit 2
}

# fail prints the fix on stderr and ends with status 1.
fail() {
	printf '%s\n' "$1" >&2
	exit 1
}

# short cuts a value to 100 characters for an error line.
short() {
	printf '%s' "$1" | tr -d '[:cntrl:]' | cut -c 1-100
}

# count_bytes prints the number of bytes of the value $1.
count_bytes() {
	printf '%s' "$1" | wc -c | tr -d ' '
}

# chars prints the number of characters of the file $1: every byte that is not a
# UTF-8 continuation byte, whatever the locale is.
chars() {
	tr -d '\200-\277' <"$1" | wc -c | tr -d ' '
}

# has_control succeeds when the value $1 has a control character or a line feed.
has_control() {
	[ "$(count_bytes "$1")" != "$(printf '%s' "$1" | tr -d '[:cntrl:]' | wc -c | tr -d ' ')" ]
}

# check_branch refuses the branch name $2 of the variable $1 when git or gh would
# misread it.
check_branch() {
	if [ -z "$2" ]; then
		refuse "Set $1 to a branch name: it is empty."
	fi
	if has_control "$2"; then
		refuse "Set $1 to a branch name: the value has a control character."
	fi
	case $2 in
	-* | /* | */ | *//* | *..* | *'@{'* | *.lock | *. | @ | *' '* | *'~'* | *'^'* | *':'* | *'?'* | *'*'* | *'['* | *'\'* | *'"'*)
		refuse "Set $1 to a branch name that git accepts: \"$(short "$2")\" is not one."
		;;
	esac
	if [ "$(count_bytes "$2")" -gt 255 ]; then
		refuse "Set $1 to a branch name of at most 255 bytes."
	fi
}

# is_hex succeeds when $1 is 40 or 64 lower-case hexadecimal digits.
is_hex() {
	case $1 in
	*[!0-9a-f]*) return 1 ;;
	esac
	[ "$(count_bytes "$1")" = 40 ] || [ "$(count_bytes "$1")" = 64 ]
}

# ---------------------------------------------------------------- the inputs

system=${QORY_SUBMIT_SYSTEM:-}
path=${QORY_SUBMIT_PATH:-}
branch=${QORY_SUBMIT_BRANCH:-}
draft=${QORY_SUBMIT_DRAFT:-}

if [ -z "$system" ]; then
	refuse "Set QORY_SUBMIT_SYSTEM to $HOST: the variable is not set."
fi
if [ "$(printf '%s' "$system" | tr 'A-Z' 'a-z')" != "$HOST" ]; then
	refuse "Compose a submit program for $(short "$system"): this one opens pull requests on $HOST only."
fi

case $path in
*[!A-Za-z0-9._/-]* | /* | */ | */*/* | "")
	refuse "Set QORY_SUBMIT_PATH to owner/name: \"$(short "$path")\" is not a repository path."
	;;
*/*) ;;
*)
	refuse "Set QORY_SUBMIT_PATH to owner/name: \"$(short "$path")\" is not a repository path."
	;;
esac
owner=${path%%/*}
name=${path#*/}
case $owner in
"" | *[!A-Za-z0-9-]* | -*)
	refuse "Set QORY_SUBMIT_PATH to owner/name: \"$(short "$path")\" has no valid owner."
	;;
esac
case $name in
"" | . | .. | .git)
	refuse "Set QORY_SUBMIT_PATH to owner/name: \"$(short "$path")\" has no valid name."
	;;
esac

check_branch QORY_SUBMIT_BRANCH "$branch"

case $draft in
open | none) ;;
*)
	refuse "Set QORY_SUBMIT_DRAFT to open or none: \"$(short "$draft")\" is neither."
	;;
esac

base_commit=${QORY_SUBMIT_BASE_COMMIT:-}
if ! is_hex "$base_commit"; then
	refuse 'Set QORY_SUBMIT_BASE_COMMIT to a commit id of 40 or 64 lower-case hexadecimal digits.'
fi

commits=${QORY_SUBMIT_COMMITS:-}
if has_control "$commits"; then
	refuse 'Join the commit ids in QORY_SUBMIT_COMMITS by single spaces: the value has a control character.'
fi
case $commits in
*'  '* | ' '* | *' ')
	refuse 'Join the commit ids in QORY_SUBMIT_COMMITS by single spaces.'
	;;
esac
count=0
for c in $commits; do
	if ! is_hex "$c"; then
		refuse "Set QORY_SUBMIT_COMMITS to commit ids of 40 or 64 lower-case hexadecimal digits: \"$(short "$c")\" is not one."
	fi
	count=$((count + 1))
done
if [ "$count" -lt 1 ] || [ "$count" -gt 100 ]; then
	refuse "Set QORY_SUBMIT_COMMITS to 1 to 100 commit ids: it has $count."
fi

title=
base_branch=
description_file=
if [ "$draft" = open ]; then
	title=${QORY_SUBMIT_TITLE:-}
	if [ -z "$title" ]; then
		refuse 'Set QORY_SUBMIT_TITLE to the title of the draft: it is not set or is empty.'
	fi
	if has_control "$title"; then
		refuse 'Set QORY_SUBMIT_TITLE to a title on one line with no control character.'
	fi
	if [ -z "$(printf '%s' "$title" | tr -d ' ')" ]; then
		refuse 'Set QORY_SUBMIT_TITLE to a title with a character that is not a space.'
	fi
	title_len=$(printf '%s' "$title" | tr -d '\200-\277' | wc -c | tr -d ' ')
	if [ "$title_len" -gt "$MAX_TITLE" ]; then
		refuse "Shorten QORY_SUBMIT_TITLE to $MAX_TITLE characters: it has $title_len."
	fi
	base_branch=${QORY_SUBMIT_BASE_BRANCH:-}
	if [ -z "$base_branch" ]; then
		refuse 'Set QORY_SUBMIT_BASE_BRANCH to the base branch of the draft: qory did not read it, so the draft has no base.'
	fi
	check_branch QORY_SUBMIT_BASE_BRANCH "$base_branch"
	description_file=${QORY_SUBMIT_DESCRIPTION_FILE:-}
	if [ -z "$description_file" ]; then
		refuse 'Set QORY_SUBMIT_DESCRIPTION_FILE to the file with the description: the variable is not set.'
	fi
	if [ ! -f "$description_file" ] || [ ! -r "$description_file" ]; then
		refuse "Make the description file readable: $(short "$description_file") is not a readable file."
	fi
	description_len=$(chars "$description_file")
	if [ "$description_len" -gt "$MAX_DESCRIPTION" ]; then
		refuse "Shorten the description to $MAX_DESCRIPTION characters: it has $description_len."
	fi
fi

# ----------------------------------------------------- the commit addresses

for c in $base_commit $commits; do
	printf 'commit_url %s https://%s/%s/commit/%s\n' "$c" "$HOST" "$path" "$c"
done

if [ "$draft" = none ]; then
	exit 0
fi

# ----------------------------------------------------------------- the login

if ! command -v gh >/dev/null 2>&1; then
	fail 'Install gh from https://cli.github.com, run `gh auth login`, then `qory run` again.'
fi
if ! gh auth status --hostname "$HOST" --active >/dev/null 2>&1 </dev/null; then
	printf '%s\n' "$LOGIN_LINE" >&2
	exit 3
fi

tmp=$(mktemp -d "${TMPDIR:-/tmp}/open-draft.XXXXXX")

# gh_fail ends the program for a failed gh call: it prints the fix, then the cause
# that gh gave, with every token of the environment masked. A rejected login is the
# same as no login.
gh_fail() {
	if grep -q 'HTTP 401' "$tmp/gh.err" 2>/dev/null; then
		printf '%s\n' "$LOGIN_LINE" >&2
		exit 3
	fi
	_cause=$(grep -v '^$' "$tmp/gh.err" 2>/dev/null | head -n 1 | tr -d '\000-\010\013-\037\177' |
		awk '{
			s = $0
			n = split("GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN", names, " ")
			for (i = 1; i <= n; i++) {
				v = ENVIRON[names[i]]
				while (length(v) >= 4 && (j = index(s, v)) > 0) {
					s = substr(s, 1, j - 1) "***" substr(s, j + length(v))
				}
			}
			print substr(s, 1, 200)
		}')
	if [ -z "$_cause" ]; then
		_cause='gh printed no message'
	fi
	printf 'Check your gh login and its access to %s, then run `qory run` again: %s failed: %s\n' "$path" "$1" "$_cause" >&2
	exit 1
}

# read_pull reads pull request $1 into $tmp/pull: 8 lines and its description.
read_pull() {
	if ! gh api -X GET --hostname "$HOST" "repos/$path/pulls/$1" --jq "$READ_JQ" \
		>"$tmp/pull" 2>"$tmp/gh.err" </dev/null; then
		gh_fail "the read of pull request $1"
	fi
	if [ "$(wc -l <"$tmp/pull" | tr -d ' ')" -lt 9 ]; then
		fail "Check that gh reaches $HOST, then run \`qory run\` again: the read of pull request $1 returned no pull request."
	fi
}

# find_pull sets number to the pull request from the branch, or to nothing. It looks
# at the head branch and the repository alone, in any state. Of several it takes the
# highest number that is not closed and not merged, else the highest number.
find_pull() {
	if ! gh api -X GET --hostname "$HOST" "repos/$path/pulls" \
		-f "head=$owner:$branch" -f state=all -f per_page=100 --jq "$LIST_JQ" \
		>"$tmp/list" 2>"$tmp/gh.err" </dev/null; then
		gh_fail 'the search for the pull request of the branch'
	fi
	number=$(awk -v want_repo="$path" '
		{
			f = (NR - 1) % 8 + 1
			v[f] = $0
			if (f == 8 && v[2] == ENVIRON["QORY_SUBMIT_BRANCH"] && tolower(v[3]) == tolower(want_repo)) {
				n = v[1] + 0
				if (v[4] == "open" && v[5] == "false" && n > best_open) best_open = n
				if (n > best_any) best_any = n
			}
		}
		END {
			if (best_open > 0) print best_open
			else if (best_any > 0) print best_any
		}
	' "$tmp/list")
}

# marked_description writes $tmp/before, the description that the pull request has,
# and $tmp/after, the description with the text of the file $1 in its block. The rule
# is that of contracts.MarkedDescription: the lines of the description are the
# records of awk, and gh adds one line feed after it.
marked_description() {
	sed '1,8d' "$tmp/pull" >"$tmp/existing"
	awk -v start="$START" -v end="$END" -v pre="$tmp/prefix" -v suf="$tmp/suffix" '
		function marker(line, m,    t) {
			t = line
			sub(/[ \t\r]+$/, "", t)
			return t == m
		}
		{ lines[NR] = $0 }
		END {
			n = NR
			existing = ""
			for (i = 1; i <= n; i++) existing = existing (i > 1 ? "\n" : "") lines[i]
			eol = "\n"
			if (n >= 2 && substr(lines[1], length(lines[1])) == "\r") eol = "\r\n"
			if (existing == "") {
				printf "%s", start eol > pre
				printf "%s", eol end > suf
				exit
			}
			st = 0
			for (i = 1; i <= n; i++) {
				if (marker(lines[i], start)) {
					st = i
				} else if (st > 0 && marker(lines[i], end)) {
					head = ""
					for (k = 1; k < st; k++) head = head (k > 1 ? "\n" : "") lines[k]
					if (st > 1) head = head "\n"
					t = lines[i]
					sub(/[ \t\r]+$/, "", t)
					after = substr(lines[i], length(t) + 1)
					tail = ""
					for (k = i + 1; k <= n; k++) tail = tail (k > i + 1 ? "\n" : "") lines[k]
					if (i + 1 <= n) tail = "\n" tail
					printf "%s", head start eol > pre
					printf "%s", eol end after tail > suf
					exit
				}
			}
			rest = existing
			endings = 0
			while (endings < 2) {
				if (length(rest) >= 2 && substr(rest, length(rest) - 1) == "\r\n") {
					rest = substr(rest, 1, length(rest) - 2)
				} else if (length(rest) >= 1 && substr(rest, length(rest)) == "\n") {
					rest = substr(rest, 1, length(rest) - 1)
				} else {
					break
				}
				endings++
			}
			gap = ""
			for (k = endings; k < 2; k++) gap = gap eol
			printf "%s", existing gap start eol > pre
			printf "%s", eol end > suf
		}
	' "$tmp/existing"
	{
		cat <"$tmp/prefix"
		cat <"$1"
		cat <"$tmp/suffix"
	} >"$tmp/after"
	awk '{ printf "%s%s", (NR > 1 ? "\n" : ""), $0 }' "$tmp/existing" >"$tmp/before"
}

# print_draft prints the five draft lines of the pull request in $tmp/pull. The
# action is $1, or kept for a pull request that is closed or merged.
print_draft() {
	_state=$(sed -n 4p "$tmp/pull")
	if [ "$(sed -n 5p "$tmp/pull")" = true ]; then
		_state=merged
	elif [ "$_state" = open ] && [ "$(sed -n 6p "$tmp/pull")" = true ]; then
		_state=draft
	fi
	_action=$1
	case $_state in
	closed | merged) _action=kept ;;
	esac
	printf 'draft_number %s\n' "$(sed -n 1p "$tmp/pull")"
	printf 'draft_url %s\n' "$(sed -n 8p "$tmp/pull")"
	printf 'draft_title %s\n' "$(sed -n 7p "$tmp/pull")"
	printf 'draft_state %s\n' "$_state"
	printf 'draft_action %s\n' "$_action"
}

# ----------------------------------------------------------------- the draft

number=
find_pull

if [ -z "$number" ]; then
	{
		printf '%s\n' "$START"
		cat <"$description_file"
		printf '\n%s' "$END"
	} >"$tmp/body"
	if ! gh pr create --repo "$HOST/$path" --draft --head "$branch" --base "$base_branch" \
		--title "$title" --body-file "$tmp/body" >"$tmp/created" 2>"$tmp/gh.err" </dev/null; then
		gh_fail 'the opening of the draft pull request'
	fi
	number=$(sed -n 's|^.*/pull/\([1-9][0-9]*\)[^0-9]*$|\1|p' "$tmp/created" | tail -n 1)
	if [ -z "$number" ]; then
		find_pull
	fi
	if [ -z "$number" ]; then
		fail "Check $path on $HOST: gh opened a pull request, and the search for it from the branch found none."
	fi
	read_pull "$number"
	print_draft opened
	exit 0
fi

read_pull "$number"
state=$(sed -n 4p "$tmp/pull")
merged=$(sed -n 5p "$tmp/pull")
if [ "$state" != open ] || [ "$merged" = true ]; then
	print_draft kept
	exit 0
fi

marked_description "$description_file"
if cmp -s "$tmp/before" "$tmp/after"; then
	print_draft kept
	exit 0
fi
if ! gh api -X PATCH --hostname "$HOST" "repos/$path/pulls/$number" -F "body=@$tmp/after" \
	--silent >"$tmp/patched" 2>"$tmp/gh.err" </dev/null; then
	gh_fail "the update of pull request $number"
fi
print_draft updated
